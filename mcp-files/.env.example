# Copy this file to .env  (never share or commit .env)

# Your secret. Make one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
MCP_TOKEN=change-me-to-a-long-random-string

# The ONLY folder the AI can touch. Pick a specific folder, NOT C:\ or your whole user folder.
# It is created for you if it doesn't exist. Keep it outside this repo.
WORKSPACE_ROOT=C:/Users/YOU/mcp-workspace

PORT=8000

# Optional: set to false to accept ONLY the "Authorization: Bearer <MCP_TOKEN>" header
# (rejects the secret-in-URL form). Default is true.
# ALLOW_URL_TOKEN=true